# Copy to wheeloffortune/.env and fill in (never commit .env)
ELEVENLABS_API_KEY=your_api_key_here
# Optional: from https://elevenlabs.io/app/voice-library or `python scripts/generate_elevenlabs_vo.py --list-voices`
ELEVENLABS_VOICE_ID=3XOBzXhnDY98yeWQ3GdM
# Model: eleven_v3 (expressive + [audio tags]), eleven_multilingual_v2 (stable + SSML breaks)
ELEVENLABS_MODEL_ID=eleven_v3
# Optional: lower stability (e.g. 0.35) = more expressive on v3; higher = more consistent
# ELEVENLABS_STABILITY=0.4
